# ==============================================================
# Configurações do Bot de Waifus - Madotsu 5 (RolêSP)
# ==============================================================

# 1. ONDE OS COMANDOS DO JOGO SERÃO ENVIADOS:
# - Se for para o privado do Madotsu: número do Madotsu (ex: 5511999999999)
# - Se for diretamente no Grupo de Waifus: ID do Grupo (ex: 1203630XXXXXXXXX@g.us)
TARGET_CHAT=5511999999999

# 2. SEU NÚMERO PESSOAL PARA RECEBER PINGS E AVISOS:
# Sempre que o bot disparar m.roll, m.rroll ou m.checkin na VPS, ele enviará um
# relatório/aviso para este número informando o sucesso e o próximo horário!
# Formato: DDI (55) + DDD + Número (ex: 5511988887777)
NOTIFY_PHONE=5511988887777
ENABLE_NOTIFY=true

# 3. CONFIGURAÇÕES VIP DO MADOTSU:
# VIP: 9 rolls a cada 2h | Comum: 5 rolls a cada 2h
IS_VIP=false

# 4. INTERVALOS DE RECARGA (EM HORAS):
INTERVAL_ROLL_HOURS=2        # m.roll a cada 2 horas
INTERVAL_RROLL_HOURS=12      # m.rroll a cada 12 horas
INTERVAL_CHECKIN_HOURS=24    # m.checkin 1x ao dia (24 horas)

# 5. DELAY HUMANIZADO (SEGUNDOS):
# Intervalo aleatório entre cada roll consecutivo para simular digitação e evitar flood
DELAY_MIN=3.0
DELAY_MAX=6.0

# 6. ATIVAÇÃO DE COMANDOS:
ENABLE_ROLL=true
ENABLE_RROLL=true
ENABLE_CHECKIN=true

# Disparar uma rodada de teste logo após conectar? (true/false)
RUN_IMMEDIATELY=true

# Caminho do banco SQLite de sessão
DATABASE_PATH=session.sqlite3
