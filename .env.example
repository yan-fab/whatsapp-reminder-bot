# ==============================================================
# Configurações do Bot de Waifus - Madotsu 5 (RolêSP)
# ==============================================================

# Onde os comandos serão enviados:
# - Se for para o seu próprio número ou no privado do bot: 5511999999999
# - Se for diretamente no Grupo de Waifus: 1203630XXXXXXXXX@g.us
# DICA: Envie !grupos no WhatsApp após conectar para o bot listar o ID de todos os seus grupos!
TARGET_CHAT=5511999999999

# Você é usuário VIP no Madotsu? (true/false)
# VIP: 9 rolls a cada 2h
# Comum: 5 rolls a cada 2h
IS_VIP=false

# Intervalos de envio em horas (conforme comandos_waifus.md):
INTERVAL_ROLL_HOURS=2        # m.roll a cada 2 horas
INTERVAL_RROLL_HOURS=12      # m.rroll a cada 12 horas
INTERVAL_CHECKIN_HOURS=24    # m.checkin 1x ao dia (24 horas)

# Delay em segundos entre cada roll para simular digitação humana e evitar bloqueio/anti-flood:
DELAY_MIN=3.0
DELAY_MAX=6.0

# Ativar/Desativar rotinas individuais (true/false):
ENABLE_ROLL=true
ENABLE_RROLL=true
ENABLE_CHECKIN=true

# Executar o primeiro ciclo logo após escanear o QR Code/conectar? (true/false)
RUN_IMMEDIATELY=true

# Caminho do banco SQLite de sessão
DATABASE_PATH=session.sqlite3
