# ==============================================================
# Configurações do WhatsApp Reminder Bot
# ==============================================================

# Seu número de WhatsApp completo com código do país e DDD
# Formato: DDI + DDD + Número (apenas dígitos ou com pontuação, o bot limpa automaticamente)
# Exemplo Brasil: 5511999999999 (55 = Brasil, 11 = SP, 999999999 = celular)
TARGET_PHONE=5511999999999

# Intervalo entre cada envio em HORAS (ex: 1, 2, 4, 0.5)
REMINDER_INTERVAL_HOURS=2

# Intervalo adicional em MINUTOS (útil para testes rápidos, ex: 1 para testar a cada 1 minuto)
REMINDER_INTERVAL_MINUTES=0

# Mensagem do Lembrete (suporta formatação do WhatsApp: *negrito*, _itálico_, etc.)
REMINDER_MESSAGE=🔔 *Lembrete Automático*\n\nHora de fazer uma pausa, beber água e conferir suas tarefas! 💧🚀

# Enviar o primeiro lembrete imediatamente ao iniciar o bot? (true/false)
RUN_IMMEDIATELY=true

# Caminho do arquivo de banco de dados SQLite onde fica salva a sessão
DATABASE_PATH=session.sqlite3
